     <input type=\"color\" title=\"Overlay Color\" name=\"overlayColor\" value=\"#ffffff\" condition=\"overlay && bg.type !== 'color'\">\n        <input type=\"range\" inline title=\"Opacity\" name=\"overlayOpacity\" min=\"0\" max=\"1\" step=\"0.1\" value=\"0.5\" condition=\"overlay && bg.type !== 'color'\">\n    </mbr-parameters>\n    <div class=\"mbr-overlay\" mbr-if=\"overlay && bg.type!== 'color'\" mbr-style=\"{'opacity': overlayOpacity, 'background-color': overlayColor}\">\n    </div>\n    <div mbr-class=\"{'container': !fullWidth, 'container-fluid': fullWidth}\">\n        <div class=\"row mb-5 justify-content-center\" mbr-if=\"showMainTitle || showMainSubtitle\">\n            <div class=\"col-12 content-head\">\n                <h3 class=\"mbr-section-title mbr-fonts-style align-center mb-0\" mbr-theme-style=\"display-5\" mbr-if=\"showMainTitle\" data-app-selector=\".mbr-section-title\"><b>III. ročník (2019/20)</b></h3>\n                <h5 class=\"mbr-section-subtitle mbr-fonts-style align-center mb-0 mt-4\" mbr-theme-style=\"display-7\" mbr-if=\"showMainSubtitle\" data-app-selector=\".mbr-section-subtitle\"><i>Šéfredaktorka: Pavlína Lenghartová // Grafika: Filip Janeček // Konzultace a korektura: Mgr. Věra Janečková</i></h5>\n            </div>\n        </div>\n        <div class=\"row\">\n            <div class=\"col-12\">\n                <div class=\"embla position-relative\" data-loop=\"{{loop}}\" data-auto-play=\"{{autoplay}}\" data-auto-play-interval=\"{{interval}}\" data-draggable=\"{{draggable}}\" data-skip-snaps=\"true\" data-align=\"center\" data-contain-scroll=\"trimSnaps\">\n                    <div class=\"embla__viewport\">\n                        <div class=\"embla__container\">\n                            \n                            \n                            <div class=\"embla__slide slider-image item active\" mbr-style=\"{'margin-left': gap + 'rem', 'margin-right': gap + 'rem'}\">\n                                <div class=\"slide-content\">\n                                    <div class=\"item-img\">\n                                        <div class=\"item-wrapper\">\n                                            \n                                        <a href=\"https://gjp.itkid.cz/digi/pdf/35-kveten-cerven-2025-viii-rocnik/\" target=\"true\"></a><a href=\"https://gjp.itkid.cz/digi/pdf/30-konec-skolniho-roku-2023-24-vii-rocnik/\" target=\"true\"></a><a href=\"https://gjp.itkid.cz/digi/pdf/28-kveten-cerven-2023-vi-rocnik/\" target=\"true\"></a><a href=\"https://gjp.itkid.cz/digi/pdf/23-kveten-cerven-2022-v-rocnik/\" target=\"true\"></a><a href=\"https://gjp.itkid.cz/digi/pdf/14-brezen-duben-kveten-cerven-2020-iii-rocnik/\" target=\"true\"><img src=\"@PROJECT_PATH@/assets/images/14-1200x1697.jpg\" alt=\"28\" title data-slide-to=\"0\" data-bs-slide-to=\"0\"></a></div>\n                                    </div>\n                                </div>\n                            </div><div class=\"embla__slide slider-image item\" mbr-style=\"{'margin-left': gap + 'rem', 'margin-right': gap + 'rem'}\">\n                                <div class=\"slide-content\">\n                                    <div class=\"item-img\">\n                                        <div class=\"item-wrapper\">\n                                            \n                                        <a href=\"https://gjp.itkid.cz/digi/pdf/35-kveten-cerven-2025-viii-rocnik/\" target=\"true\"></a><a href=\"https://gjp.itkid.cz/digi/pdf/30-konec-skolniho-roku-2023-24-vii-rocnik/\" target=\"true\"></a><a href=\"https://gjp.itkid.cz/digi/pdf/28-kveten-cerven-2023-vi-rocnik/\" target=\"true\"></a><a href=\"https://gjp.itkid.cz/digi/pdf/23-kveten-cerven-2022-v-rocnik/\" target=\"true\"></a><a href=\"https://gjp.itkid.cz/digi/pdf/14-brezen-duben-kveten-cerven-2020-iii-rocnik/\" target=\"true\"></a><a href=\"https://gjp.itkid.cz/digi/pdf/13-leden-unor-2020-iii-rocnik/\" target=\"true\"><img src=\"@PROJECT_PATH@/assets/images/13-1200x1697.jpg\" alt=\"28\" title data-slide-to=\"1\" data-bs-slide-to=\"1\"></a></div>\n                                    </div>\n                                </div>\n                            </div><div class=\"embla__slide slider-image item\" mbr-style=\"{'margin-left': gap + 'rem', 'margin-right': gap + 'rem'}\">\n                                <div class=\"slide-content\">\n                                    <div class=\"item-img\">\n                                        <div class=\"item-wrapper\">\n                                            \n                                        <a href=\"https://gjp.itkid.cz/digi/pdf/35-kveten-cerven-2025-viii-rocnik/\" target=\"true\"></a><a href=\"https://gjp.itkid.cz/digi/pdf/30-konec-skolniho-roku-2023-24-vii-rocnik/\" target=\"true\"></a><a href=\"https://gjp.itkid.cz/digi/pdf/28-kveten-cerven-2023-vi-rocnik/\" target=\"true\"></a><a href=\"https://gjp.itkid.cz/digi/pdf/23-kveten-cerven-2022-v-rocnik/\" target=\"true\"></a><a href=\"https://gjp.itkid.cz/digi/pdf/14-brezen-duben-kveten-cerven-2020-iii-rocnik/\" target=\"true\"></a><a href=\"https://gjp.itkid.cz/digi/pdf/12-listopad-prosinec-2019-iii-rocnik/\" target=\"true\"><img src=\"@PROJECT_PATH@/assets/images/12-1200x1697.jpg\" alt=\"28\" title data-slide-to=\"2\" data-bs-slide-to=\"2\"></a></div>\n                                    </div>\n                                </div>\n                            </div><div class=\"embla__slide slider-image item\" mbr-style=\"{'margin-left': gap + 'rem', 'margin-right': gap + 'rem'}\">\n                                <div class=\"slide-content\">\n                                    <div class=\"item-img\">\n                                        <div class=\"item-wrapper\">\n                                            \n                                        <a href=\"https://gjp.itkid.cz/digi/pdf/35-kveten-cerven-2025-viii-rocnik/\" target=\"true\"></a><a href=\"https://gjp.itkid.cz/digi/pdf/30-konec-skolniho-roku-2023-24-vii-rocnik/\" target=\"true\"></a><a href=\"https://gjp.itkid.cz/digi/pdf/28-kveten-cerven-2023-vi-rocnik/\" target=\"true\"></a><a href=\"https://gjp.itkid.cz/digi/pdf/23-kveten-cerven-2022-v-rocnik/\" target=\"true\"></a><a href=\"https://gjp.itkid.cz/digi/pdf/14-brezen-duben-kveten-cerven-2020-iii-rocnik/\" target=\"true\"></a><a href=\"https://gjp.itkid.cz/digi/pdf/11-zari-rijen-2019-iii-rocnik/\" target=\"true\"><img src=\"@PROJECT_PATH@/assets/images/11-1200x1697.jpg\" alt=\"28\" title data-slide-to=\"3\" data-bs-slide-to=\"3\"></a></div>\n                                    </div>\n                                </div>\n                            </div>\n                            \n                            \n                            \n                            \n                        </div>\n                    </div>\n                    <button class=\"embla__button embla__button--prev\">\n                        <span class=\"mobi-mbri mobi-mbri-arrow-prev\" aria-hidden=\"true\"></span>\n                        <span class=\"sr-only visually-hidden visually-hidden\">Previous</span>\n                    </button>\n                    <button class=\"embla__button embla__button--next\">\n                        <span class=\"mobi-mbri mobi-mbri-arrow-next\" aria-hidden=\"true\"></span>\n                        <span class=\"sr-only visually-hidden visually-hidden\">Next</span>\n                    </button>\n                </div>\n            </div>\n        </div>\n    </div>\n</section>",
          "_anchor": "slider04-1y",

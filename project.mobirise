            ".mbr-section-title": {
              "color": "#393193"
            },
            ".mbr-section-subtitle": {
              "color": "#7c7d78",
              "text-align": "center"
            },
            ".mbr-box": {
              "color": "#ffffff"
            },
            ".slide-content": {
              "position": "relative",
              "border-radius": "4px",
              "height": "100%",
              "width": "100%",
              "display": "flex",
              "overflow": "hidden",
              "flex-flow": "column nowrap"
            },
            "img, .item-img": {
              "width": "100%",
              "& when (@autoSize)": {
                "height": "(@carouselHeight * 100px)",
                "object-fit": "cover"
              }
            },
            ".item-wrapper": {
              "position": "relative"
            },
            ".content-head": {
              "max-width": "800px"
            }
          },
          "_name": "slider04",
          "_sourceTheme": "startm5",
          "_customHTML": "<section data-bs-version=\"5.1\" class=\"slider4 mbr-embla\" group=\"Gallery & Slider\" mbr-class=\"{'mbr-parallax-background':bg.parallax}\" plugins=\"embla\">\n    <mbr-parameters>\n        <header>Size</header>\n        <input type=\"checkbox\" name=\"fullWidth\" title=\"Full Width\" checked>\n        <input inline type=\"range\" title=\"Top\" name=\"paddingTop\" min=\"0\" max=\"10\" step=\"1\" value=\"6\">\n        <input inline type=\"range\" title=\"Bottom\" name=\"paddingBottom\" min=\"0\" max=\"10\" step=\"1\" value=\"6\">\n        <header>Show/Hide</header>\n        <input type=\"checkbox\" title=\"Title\" name=\"showMainTitle\" checked>\n        <input type=\"checkbox\" title=\"Subtitle\" name=\"showMainSubtitle\" checked>\n        <header>Carousel</header>\n        <input type=\"checkbox\" title=\"Autoplay\" name=\"autoplay\" checked>\n        <input type=\"range\" title=\"Interval\" name=\"interval\" min=\"1\" max=\"10\" value=\"5\" step=\"1\" condition=\"autoplay\">\n        <input type=\"checkbox\" title=\"Loop\" name=\"loop\" checked>\n        <input type=\"checkbox\" title=\"Draggable\" name=\"draggable\">\n        <input type=\"checkbox\" name=\"arrows\" title=\"Arrows\" checked>\n        <header>Card</header>\n        <input type=\"range\" name=\"gap\" title=\"Gap\" min=\"0\" max=\"10\" step=\"1\" value=\"2\">\n        <input type=\"checkbox\" name=\"autoSize\" title=\"Auto Size\">\n        <input type=\"range\" name=\"carouselHeight\" title=\"Height\" min=\"1\" max=\"8\" step=\"1\" value=\"4\" condition=\"autoSize\">\n        <header>Background</header>\n        <fieldset type=\"background\" name=\"bg\" parallax>\n            <input type=\"image\" title=\"Image\" value=\"../_images/background1.jpg\" parallax>\n            <input type=\"color\" title=\"Color\" value=\"#edefeb\" selected>\n        </fieldset>\n        <input type=\"checkbox\" title=\"Overlay\" name=\"overlay\" checked condition=\"bg.type !== 'color'\">\n        <input type=\"color\" title=\"Overlay Color\" name=\"overlayColor\" value=\"#ffffff\" condition=\"overlay && bg.type !== 'color'\">\n        <input type=\"range\" inline title=\"Opacity\" name=\"overlayOpacity\" min=\"0\" max=\"1\" step=\"0.1\" value=\"0.5\" condition=\"overlay && bg.type !== 'color'\">\n    </mbr-parameters>\n    <div class=\"mbr-overlay\" mbr-if=\"overlay && bg.type!== 'color'\" mbr-style=\"{'opacity': overlayOpacity, 'background-color': overlayColor}\">\n    </div>\n    <div mbr-class=\"{'container': !fullWidth, 'container-fluid': fullWidth}\">\n        <div class=\"row mb-5 justify-content-center\" mbr-if=\"showMainTitle || showMainSubtitle\">\n            <div class=\"col-12 content-head\">\n                <h3 class=\"mbr-section-title mbr-fonts-style align-center mb-0\" mbr-theme-style=\"display-5\" mbr-if=\"showMainTitle\" data-app-selector=\".mbr-section-title\"><b>I. ročník (2017/18)</b></h3>\n                <h5 class=\"mbr-section-subtitle mbr-fonts-style align-center mb-0 mt-4\" mbr-theme-style=\"display-7\" mbr-if=\"showMainSubtitle\" data-app-selector=\".mbr-section-subtitle\"><i>Šéfredaktoři: Zdeňka Protivánková, Tomáš Suchý // Grafika: Filip Janeček // Konzultace a korektura: Mgr. Věra Janečková</i></h5>\n            </div>\n        </div>\n        <div class=\"row\">\n            <div class=\"col-12\">\n                <div class=\"embla position-relative\" data-loop=\"{{loop}}\" data-auto-play=\"{{autoplay}}\" data-auto-play-interval=\"{{interval}}\" data-draggable=\"{{draggable}}\" data-skip-snaps=\"true\" data-align=\"center\" data-contain-scroll=\"trimSnaps\">\n                    <div class=\"embla__viewport\">\n                        <div class=\"embla__container\">\n                            \n                            \n                            <div class=\"embla__slide slider-image item active\" mbr-style=\"{'margin-left': gap + 'rem', 'margin-right': gap + 'rem'}\">\n                                <div class=\"slide-content\">\n                                    <div class=\"item-img\">\n                                        <div class=\"item-wrapper\">\n                                            \n                                        <a href=\"https://gjp.itkid.cz/digi/pdf/35-kveten-cerven-2025-viii-rocnik/\" target=\"true\"></a><a href=\"https://gjp.itkid.cz/digi/pdf/30-konec-skolniho-roku-2023-24-vii-rocnik/\" target=\"true\"></a><a href=\"https://gjp.itkid.cz/digi/pdf/28-kveten-cerven-2023-vi-rocnik/\" target=\"true\"></a><a href=\"https://gjp.itkid.cz/digi/pdf/23-kveten-cerven-2022-v-rocnik/\" target=\"true\"></a><a href=\"https://gjp.itkid.cz/digi/pdf/14-brezen-duben-kveten-cerven-2020-iii-rocnik/\" target=\"true\"></a><a href=\"https://gjp.itkid.cz/digi/pdf/10-kveten-cerven-2019-ii-rocnik/\" target=\"true\"></a><a href=\"https://gjp.itkid.cz/digi/pdf/05-kveten-cerven-2018-i-rocnik/\" target=\"true\"><img src=\"@PROJECT_PATH@/assets/images/05-1-1200x1722.jpg\" alt=\"28\" title data-slide-to=\"0\" data-bs-slide-to=\"0\"></a></div>\n                                    </div>\n                                </div>\n                            </div><div class=\"embla__slide slider-image item\" mbr-style=\"{'margin-left': gap + 'rem', 'margin-right': gap + 'rem'}\">\n                                <div class=\"slide-content\">\n                                    <div class=\"item-img\">\n                                        <div class=\"item-wrapper\">\n                                            \n                                        <a href=\"https://gjp.itkid.cz/digi/pdf/35-kveten-cerven-2025-viii-rocnik/\" target=\"true\"></a><a href=\"https://gjp.itkid.cz/digi/pdf/30-konec-skolniho-roku-2023-24-vii-rocnik/\" target=\"true\"></a><a href=\"https://gjp.itkid.cz/digi/pdf/28-kveten-cerven-2023-vi-rocnik/\" target=\"true\"></a><a href=\"https://gjp.itkid.cz/digi/pdf/23-kveten-cerven-2022-v-rocnik/\" target=\"true\"></a><a href=\"https://gjp.itkid.cz/digi/pdf/14-brezen-duben-kveten-cerven-2020-iii-rocnik/\" target=\"true\"></a><a href=\"https://gjp.itkid.cz/digi/pdf/10-kveten-cerven-2019-ii-rocnik/\" target=\"true\"></a><a href=\"https://gjp.itkid.cz/digi/pdf/04-brezen-duben-2018-i-rocnik/\" target=\"true\"><img src=\"@PROJECT_PATH@/assets/images/4-1200x1697.jpg\" alt=\"28\" title data-slide-to=\"1\" data-bs-slide-to=\"1\"></a></div>\n                                    </div>\n                                </div>\n                            </div><div class=\"embla__slide slider-image item\" mbr-style=\"{'margin-left': gap + 'rem', 'margin-right': gap + 'rem'}\">\n                                <div class=\"slide-content\">\n                                    <div class=\"item-img\">\n                                        <div class=\"item-wrapper\">\n                                            \n                                        <a href=\"https://gjp.itkid.cz/digi/pdf/35-kveten-cerven-2025-viii-rocnik/\" target=\"true\"></a><a href=\"https://gjp.itkid.cz/digi/pdf/30-konec-skolniho-roku-2023-24-vii-rocnik/\" target=\"true\"></a><a href=\"https://gjp.itkid.cz/digi/pdf/28-kveten-cerven-2023-vi-rocnik/\" target=\"true\"></a><a href=\"https://gjp.itkid.cz/digi/pdf/23-kveten-cerven-2022-v-rocnik/\" target=\"true\"></a><a href=\"https://gjp.itkid.cz/digi/pdf/14-brezen-duben-kveten-cerven-2020-iii-rocnik/\" target=\"true\"></a><a href=\"https://gjp.itkid.cz/digi/pdf/10-kveten-cerven-2019-ii-rocnik/\" target=\"true\"></a><a href=\"https://gjp.itkid.cz/digi/pdf/03-leden-unor-2018-i-rocnik/\" target=\"true\"><img src=\"@PROJECT_PATH@/assets/images/3-1200x1697.jpg\" alt=\"28\" title data-slide-to=\"2\" data-bs-slide-to=\"2\"></a></div>\n                                    </div>\n                                </div>\n                            </div><div class=\"embla__slide slider-image item\" mbr-style=\"{'margin-left': gap + 'rem', 'margin-right': gap + 'rem'}\">\n                                <div class=\"slide-content\">\n                                    <div class=\"item-img\">\n                                        <div class=\"item-wrapper\">\n                                            \n                                        <a href=\"https://gjp.itkid.cz/digi/pdf/35-kveten-cerven-2025-viii-rocnik/\" target=\"true\"></a><a href=\"https://gjp.itkid.cz/digi/pdf/30-konec-skolniho-roku-2023-24-vii-rocnik/\" target=\"true\"></a><a href=\"https://gjp.itkid.cz/digi/pdf/28-kveten-cerven-2023-vi-rocnik/\" target=\"true\"></a><a href=\"https://gjp.itkid.cz/digi/pdf/23-kveten-cerven-2022-v-rocnik/\" target=\"true\"></a><a href=\"https://gjp.itkid.cz/digi/pdf/14-brezen-duben-kveten-cerven-2020-iii-rocnik/\" target=\"true\"></a><a href=\"https://gjp.itkid.cz/digi/pdf/10-kveten-cerven-2019-ii-rocnik/\" target=\"true\"></a><a href=\"https://gjp.itkid.cz/digi/pdf/02-listopad-prosinec-2017-i-rocnik/\" target=\"true\"><img src=\"@PROJECT_PATH@/assets/images/2-1200x1697.jpg\" alt=\"28\" title data-slide-to=\"3\" data-bs-slide-to=\"3\"></a></div>\n                                    </div>\n                                </div>\n                            </div><div class=\"embla__slide slider-image item\" mbr-style=\"{'margin-left': gap + 'rem', 'margin-right': gap + 'rem'}\">\n                                <div class=\"slide-content\">\n                                    <div class=\"item-img\">\n                                        <div class=\"item-wrapper\">\n                                            \n                                        <a href=\"https://gjp.itkid.cz/digi/pdf/35-kveten-cerven-2025-viii-rocnik/\" target=\"true\"></a><a href=\"https://gjp.itkid.cz/digi/pdf/30-konec-skolniho-roku-2023-24-vii-rocnik/\" target=\"true\"></a><a href=\"https://gjp.itkid.cz/digi/pdf/28-kveten-cerven-2023-vi-rocnik/\" target=\"true\"></a><a href=\"https://gjp.itkid.cz/digi/pdf/23-kveten-cerven-2022-v-rocnik/\" target=\"true\"></a><a href=\"https://gjp.itkid.cz/digi/pdf/14-brezen-duben-kveten-cerven-2020-iii-rocnik/\" target=\"true\"></a><a href=\"https://gjp.itkid.cz/digi/pdf/10-kveten-cerven-2019-ii-rocnik/\" target=\"true\"></a><a href=\"https://gjp.itkid.cz/digi/pdf/01-zari-rijen-2017-i-rocnik/\" target=\"true\"><img src=\"@PROJECT_PATH@/assets/images/1-1200x1697.jpg\" alt=\"28\" title data-slide-to=\"4\" data-bs-slide-to=\"4\"></a></div>\n                                    </div>\n                                </div>\n                            </div>\n                            \n                            \n                            \n                            \n                        </div>\n                    </div>\n                    <button class=\"embla__button embla__button--prev\">\n                        <span class=\"mobi-mbri mobi-mbri-arrow-prev\" aria-hidden=\"true\"></span>\n                        <span class=\"sr-only visually-hidden visually-hidden\">Previous</span>\n                    </button>\n                    <button class=\"embla__button embla__button--next\">\n                        <span class=\"mobi-mbri mobi-mbri-arrow-next\" aria-hidden=\"true\"></span>\n                        <span class=\"sr-only visually-hidden visually-hidden\">Next</span>\n                    </button>\n                </div>\n            </div>\n        </div>\n    </div>\n</section>",
